# Local crawler/dashboard settings
SCOUT_DATABASE_PATH=output/live/internships.db
SCOUT_OUTPUT_DIR=output/live
SCOUT_LOG_LEVEL=info

# Supabase Auth. The publishable key is safe for the browser-facing client;
# never put a secret/service-role key in this file or in client code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
AUTH_SITE_URL=http://127.0.0.1:4173
AUTH_TRUST_PROXY=0
AUTH_ALLOW_INSECURE_HTTP=0

# The Supabase RLS migration in supabase/migrations secures account-owned
# Postgres tables. The current crawler data store remains server-private SQLite.
